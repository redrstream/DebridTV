<?xml version="1.0" encoding="utf-8"?>
<!-- Focus-visible button background for the in-player View buttons (Up next / error
     panel). The default Material button focus state is nearly invisible on a 10-foot TV
     UI, so the focused/pressed state is a solid brand-green fill with a bold white ring;
     the resting state is a dim translucent chip so the difference is unmistakable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DDC97" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DDC97" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E3742" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
